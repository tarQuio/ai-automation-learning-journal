    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('On form submission').item.json.instruction }}",
        "options": {
          "systemMessage": "=Kamu adalah AI Executive Assistant.\n\nACUAN WAKTU SISTEM:\n- Waktu Sekarang: {{ $now.setZone('Asia/Makassar').format('yyyy-MM-dd HH:mm:ss') }}\n- Tanggal Hari Ini: {{ $now.setZone('Asia/Makassar').format('yyyy-MM-dd') }}\n- Tanggal BESOK: {{$now.setZone('Asia/Makassar').plus({ days: 1 }).format('yyyy-MM-dd') }}\n\nATURAN GOOGLE CALENDAR:\n1. Jika pengguna menyebut \"besok\", kamu WAJIB menggunakan Tanggal BESOK.\n2. Format parameter `start` dan `end` WAJIB ISO 8601 dengan offset jam: YYYY-MM-DDTHH:mm:ss.\n   Atur durasi default 1 jam (misal jam 15:00 sampai 16:00).\n3. Field `summary`: Isikan HANYA judul acara (misal: \"Meeting Koordinasi\") tanpa teks waktu.\n\nATURAN BALASAN AKHIR:\n- Saat memberikan balasan konfirmasi, JANGAN gunakan format Markdown kompleks seperti bintang ganda (**).\n- Tulis balasan dalam bentuk teks biasa yang rapi tanpa simbol Markdown khusus agar tidak merusak formatting API Telegram.",
          "maxIterations": 5
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        80,
        -48
      ],
      "name": "AI Agent"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        32,
        192
      ],
      "name": "Google Gemini Chat Model"
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Use this tool to create a to-do item or task in Google Tasks.",
        "task": "YOUR_TASK_LIST_ID",
        "title": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Title', ``, 'string') }}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.googleTasksTool",
      "typeVersion": 1,
      "position": [
        160,
        192
      ],
      "name": "Create a task in Google Tasks"
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Use this tool to schedule meetings, appointments, or reminders in Google Calendar.",
        "calendar": {
          "__rl": true,
          "value": "YOUR_CALENDAR_ID",
          "mode": "list",
          "cachedResultName": "N8n-calendar"
        },
        "start": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Start', ``, 'string') }}",
        "end": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('End', ``, 'string') }}",
        "useDefaultReminders": false,
        "additionalFields": {
          "summary": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Summary', ``, 'string') }}"
        }
      },
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        288,
        192
      ],
      "name": "Create an event in Google Calendar"
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
