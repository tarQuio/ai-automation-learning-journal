{
  "name": "Customer Support Bot",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        64,
        64
      ],
      "name": "Telegram Trigger"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "Kamu adalah Customer Service AI yang ramah, profesional, dan membantu untuk toko kami.\n\nAturan Kerja:\n1. Jika pengguna hanya memberikan sapaan umum (seperti \"Halo\", \"Hai\", \"Selamat pagi\", dsb), jawablah sapaan tersebut dengan ramah dan tanyakan apa yang bisa dibantu TANPA menggunakan tool Google Sheets.\n2. Gunakan Knowledge Base (Google Sheets Tool) HANYA jika pengguna menanyakan pertanyaan spesifik seputar toko, produk, jam operasional, garansi, atau pembayaran.\n3. Jawab pertanyaan berdasarkan data yang ditemukan di Knowledge Base.\n4. Mengingat konteks percakapan dari pesan sebelumnya jika pengguna bertanya secara bertahap.\n5. Jika informasi tidak ditemukan di Knowledge Base, jawab dengan sopan bahwa kamu belum memiliki informasi tersebut dan sarankan untuk menghubungi admin manusia."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        352,
        64
      ],
      "name": "AI Agent"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        304,
        304
      ],
      "name": "Google Gemini Chat Model"
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.message.chat.id }}"
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        448,
        304
      ],
      "name": "Simple Memory"
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Gunakan tool ini untuk membaca seluruh data FAQ dan informasi layanan service PC/laptop TechFix Studio dari Google Sheets saat pengguna bertanya seputar operasional, harga/jenis service, garansi, atau pembayaran.",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "list",
          "cachedResultName": "Day 6 - FAQ Knowledge Base"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list",
          "cachedResultName": "Sheet1"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheetsTool",
      "typeVersion": 4.6,
      "position": [
        560,
        304
      ],
      "name": "Get row(s) in sheet in Google Sheets"
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        752,
        64
      ],
      "name": "Send a text message"
    }
  ],
