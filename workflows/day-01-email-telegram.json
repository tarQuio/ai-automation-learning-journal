      "parameters": {
        "jsCode": "return items.map(item => {\n  // 1. Ambil data langsung dari properti teratas JSON Gmail Anda\n  const rawSender = item.json.From || 'Unknown Sender';\n  const rawSubject = item.json.Subject || 'No Subject';\n  const rawSnippet = item.json.snippet || '';\n\n  // 2. Rapikan isi snippet agar tidak terlalu panjang (maksimal 150 karakter)\n  const cleanSnippet = rawSnippet.length > 150 \n    ? rawSnippet.substring(0, 150) + '...' \n    : rawSnippet;\n\n  // 3. Kembalikan variabel yang sudah bersih dan siap dipakai\n  return {\n    json: {\n      pengirim: rawSender,\n      subjek: rawSubject,\n      isi: cleanSnippet || 'Tidak ada pratinjau pesan.'\n    }\n  };\n});"
