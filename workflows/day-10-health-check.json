    {
      "parameters": {
        "jsCode": "// ============================================================\n// Day 10 - Code node: \"Evaluate & Detect Changes\"\n// Letakkan SETELAH node Merge (4 probe digabung).\n// Mode: Run Once for All Items, bahasa JavaScript.\n//\n// Tiap item masuk harus punya field `probe` (diisi node Edit Fields\n// setelah tiap probe) dan hasil mentah probe: `statusCode` (HTTP Request\n// dengan opsi Never Error) atau `error` (node yang gagal dan Continue).\n//\n// Catatan penting: $getWorkflowStaticData hanya menyimpan nilai pada\n// eksekusi PRODUCTION (workflow Active, dipicu Schedule Trigger).\n// Saat tombol Execute di editor, state tidak tersimpan.\n// ============================================================\n\nconst state = $getWorkflowStaticData('global');\nconst sebelumnya = state.status || {};\nconst sekarang = {};\nconst alarm = [];\nconst ringkasan = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n  const nama = j.probe || 'unknown';\n  const kode = j.statusCode ?? j.error?.code ?? null;\n\n  // Gagal jika ada field error, atau kode HTTP >= 400\n  const gagal = Boolean(j.error) || (kode !== null && kode >= 400);\n  const status = gagal ? 'FAIL' : 'OK';\n  sekarang[nama] = status;\n\n  // Anggap kondisi awal OK, jadi kegagalan pada run pertama tetap diberi tahu\n  const lalu = sebelumnya[nama] || 'OK';\n  const label = kode !== null ? `HTTP ${kode}` : 'error';\n\n  ringkasan.push(`${nama}: ${status}`);\n\n  if (lalu === 'OK' && status === 'FAIL') {\n    alarm.push(`🔴 ${nama} GAGAL (${label})`);\n  } else if (lalu === 'FAIL' && status === 'OK') {\n    alarm.push(`🟢 ${nama} pulih`);\n  }\n  // Status tidak berubah: tidak ada alarm (mencegah spam tiap 30 menit)\n}\n\n// Simpan status terbaru untuk run berikutnya\nstate.status = sekarang;\n\nreturn [{\n  json: {\n    ada_alarm: alarm.length > 0,\n    judul: '🩺 Health Check Bot Q dan A',\n    pesan: alarm.join('\\n'),\n    ringkasan: ringkasan.join(' | '),\n  },\n}];\n\n// ============================================================\n// Pemetaan field untuk node \"Execute Workflow\" (memanggil Sub: Send Alert)\n//   judul : {{ $json.judul }}\n//   pesan : {{ $json.pesan }}\n//\n// Pemetaan di Global Error Handler (menggantikan node Telegram lama):\n//   judul : ⚠️ Bot Q dan A gagal\n//   pesan : Workflow: {{ $('Code in JavaScript').item.json.workflow }}\n//           Node: {{ $('Code in JavaScript').item.json.node }}\n//           Waktu: {{ $('Code in JavaScript').item.json.waktu }}\n//           Link: {{ $('Code in JavaScript').item.json.url }}\n// ============================================================"
      },
      "type": "n8n-nodes-base.code",
